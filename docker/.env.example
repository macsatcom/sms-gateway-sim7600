# SMS Gateway — SIM7600E configuration
# Copy to .env and edit before starting:
#   cp docker/.env.example docker/.env

# ── Modem ─────────────────────────────────────────────────────────────────────
# Serial port for AT commands.
# SIM7600E USB interface layout:
#   ttyUSB0 = Diagnostic
#   ttyUSB1 = GPS NMEA stream  (raw NMEA sentences — not used by this gateway)
#   ttyUSB2 = AT commands      ← default MODEM_PORT
#   ttyUSB3 = PPP data modem
#   ttyUSB4 = ADB
#   ttyACM0 = CDC-NCM (network interface)
#
# Confirm your AT port with GET /debug/ports (after startup), or run:
#   for p in /dev/ttyUSB{0..7}; do
#     echo -n "$p: "
#     python3 -c "import serial,time; s=serial.Serial('$p',115200,timeout=1); s.write(b'AT\r\n'); time.sleep(0.3); print(repr(s.read(64))); s.close()"
#   done
MODEM_PORT=/dev/ttyUSB2
BAUD_RATE=115200

# Secondary AT port used for incoming SMS monitoring (URC listener).
# On SIM7600E, ttyUSB7 is a second AT-capable interface that can receive
# +CMTI notifications independently of the main MODEM_PORT session.
# Leave empty to disable incoming SMS monitoring and the /sms/stream endpoint.
MONITOR_PORT=/dev/ttyUSB7

# Seconds to wait for each AT command response.
# Increase to 30.0 if your carrier is slow to confirm CMGS.
CMD_TIMEOUT=5.0

# ── SIM ───────────────────────────────────────────────────────────────────────
# SIM card PIN (optional).
# If set, the gateway unlocks the SIM automatically on startup.
# Leave empty if your SIM has no PIN (or PIN is disabled).
SIM_PIN=

# ── GPS ───────────────────────────────────────────────────────────────────────
# The SIM7600E exposes two GPS-related serial ports:
#
#   ttyUSB1 = Raw NMEA sentence stream (passive, always outputs when GPS is on)
#   ttyUSB2 = AT commands — used by this gateway via AT+CGPS / AT+CGPSINFO
#
# This gateway reads GPS location through AT commands on MODEM_PORT (ttyUSB2).
# ttyUSB1 is not used by the gateway, but is available for external consumers
# (e.g. gpsd, GPSBabel) that want the raw NMEA stream directly.
GPS_NMEA_PORT=/dev/ttyUSB1

# Set to 1 to power on the GNSS module automatically when the daemon starts.
# After enabling, allow 30–60 seconds outdoors with clear sky for a first fix.
# Use GET /gps/status and GET /gps/location to check state and read position.
GPS_AUTOSTART=0

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000

# Restricted API port — exposes only /health, /status, and /sms/send.
# Safe to forward externally (e.g. via your router or reverse proxy).
# Full API (logs, debug, token management) remains on API_PORT only.
RESTRICTED_PORT=8007

# ── API keys ──────────────────────────────────────────────────────────────────
# Named API tokens — preferred over API_KEY when you need multiple clients.
# Format: name:token,name:token  (comma-separated, no spaces around colon)
# Each name appears in GET /tokens usage statistics.
# Generate strong tokens: openssl rand -hex 32
#
# Example:
#   API_KEYS=admin:supersecrettoken,ci:anothertoken,homeassistant:thirdtoken
API_KEYS=

# Legacy single-token fallback (used if API_KEYS is empty).
# Treated as a token named "default" in usage stats.
API_KEY=

# ── Statistics dashboard ───────────────────────────────────────────────────────
# Password for GET /stats — separate from the API keys used by callers.
# If set, only this password (or any valid API key) can access GET /api/stats.
# If left empty, the dashboard falls back to requiring a regular API key.
# Generate a strong value: openssl rand -hex 20
STATS_PASSWORD=

# ── Usage log ─────────────────────────────────────────────────────────────────
# Path to the SQLite database that stores the persistent request log.
# Mounted via the sms_data Docker volume — survives container restarts.
# Accessible via GET /logs and GET /tokens in the API.
LOG_DB=/data/sms-gateway.db

# ── Debug ─────────────────────────────────────────────────────────────────────
# Set to 1 to log all raw AT command I/O to stdout.
# GET /debug/at and GET /debug/ports are always available (auth required).
DEBUG=0
