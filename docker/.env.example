# SMS Gateway — SIM7600E configuration
# Copy to .env and edit before starting:
#   cp docker/.env.example docker/.env

# ── Modem ─────────────────────────────────────────────────────────────────────
# Serial port for AT commands.
# SIM7600E interface layout:
#   ttyUSB0 = Diagnostic  ttyUSB1 = GPS NMEA  ttyUSB2 = AT commands (default)
#   ttyUSB3 = PPP modem   ttyUSB4 = ADB       ttyACM0 = CDC-NCM
#
# Confirm your AT port with GET /debug/ports (after startup), or run:
#   for p in /dev/ttyUSB{0..7}; do
#     echo -n "$p: "
#     python3 -c "import serial,time; s=serial.Serial('$p',115200,timeout=1); s.write(b'AT\r\n'); time.sleep(0.3); print(repr(s.read(64))); s.close()"
#   done
MODEM_PORT=/dev/ttyUSB2
BAUD_RATE=115200

# Seconds to wait for each AT command response.
# Increase to 30.0 if your carrier is slow to confirm CMGS.
CMD_TIMEOUT=5.0

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000

# Restricted API port — exposes only /health, /status, and /sms/send.
# Safe to forward externally (e.g. via your router or reverse proxy).
# Full API (logs, debug, token management) remains on API_PORT only.
RESTRICTED_PORT=8007

# SIM card PIN (optional).
# If set, the gateway unlocks the SIM automatically on startup.
# Leave empty if your SIM has no PIN (or PIN is disabled).
SIM_PIN=

# ── API keys ──────────────────────────────────────────────────────────────────
# Named API tokens — preferred over API_KEY when you need multiple clients.
# Format: name:token,name:token  (comma-separated, no spaces around colon)
# Each name appears in GET /tokens usage statistics.
# Generate strong tokens: openssl rand -hex 32
#
# Example:
#   API_KEYS=admin:supersecrettoken,ci:anothertoken,homeassistant:thirdtoken
API_KEYS=

# Legacy single-token fallback (used if API_KEYS is empty).
# Treated as a token named "default" in usage stats.
API_KEY=

# ── Usage log ─────────────────────────────────────────────────────────────────
# Path to the SQLite database that stores the persistent request log.
# Mounted via the sms_data Docker volume — survives container restarts.
# Accessible via GET /logs and GET /tokens in the API.
LOG_DB=/data/sms-gateway.db

# ── Debug ─────────────────────────────────────────────────────────────────────
# Set to 1 to log all raw AT command I/O to stdout.
# GET /debug/at and GET /debug/ports are always available (auth required).
DEBUG=0
